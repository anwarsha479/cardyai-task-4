# Copy to .env in this folder. Values here are for local development only.

# PostgreSQL: your local server (the one DBeaver connects to). Create DB_NAME first; tests create DB_NAME_TEST.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=library_lending
DB_NAME_TEST=library_lending_test

# Backend API
API_PORT=3050
CORS_ORIGIN=http://localhost:5177
JWT_SECRET=change-me-dev-only-secret
JWT_EXPIRES_IN=8h
# How often expired reservation holds are passed to the next member (0 turns the job off)
HOLD_SWEEP_INTERVAL_SECONDS=5

# Seed (npm run seed) - demo-only password for the seeded accounts
SEED_DEMO_PASSWORD=demo-only-password

# Frontend (Vite reads VITE_* variables from this file)
FRONTEND_PORT=5177
VITE_API_BASE_URL=http://localhost:3050/api
# ISO 4217 code used to show fines
VITE_CURRENCY=USD
